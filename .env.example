# Valores com $ (senhas, salts) devem ficar entre aspas SIMPLES: com aspas duplas
# ou sem aspas o docker compose interpreta $algo como variável e altera o valor.

# ===== Projeto (usado pelo docker-compose.yml) =====
# Nome do container (aparece no docker ps)
PROJECT_NAME="meu-projeto"

# Nome da pasta do tema dentro de themes/ (montada em wp-content/themes/)
THEME_NAME="meu-tema"

# Porta local do site (http://localhost:PORTA). Mude se já tiver outro projeto na 80.
HTTP_PORT="80"

# ===== WordPress =====
# URLs usadas só quando o site é acessado por um host que não seja localhost (ex.: túnel/ngrok).
WP_SITEURL="http://localhost"
WP_HOME="http://localhost"

# URL de produção dos uploads. Arquivos de mídia que não existem localmente
# são redirecionados para cá (não precisa baixar a pasta uploads).
PRODUCTION_UPLOADS_URL="https://seusite.com.br/wp-content/uploads"

# Chaves e salts de autenticação. Gere novos valores em:
# https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=''
SECURE_AUTH_KEY=''
LOGGED_IN_KEY=''
NONCE_KEY=''
AUTH_SALT=''
SECURE_AUTH_SALT=''
LOGGED_IN_SALT=''
NONCE_SALT=''

# ===== Banco de dados (MySQL externo) =====
# Para um MySQL rodando na sua máquina use DB_HOST="host.docker.internal:3306".
# Cuidado: se apontar para o banco de produção, tudo que for feito no wp-admin local altera o site real.
DB_HOST=""
DB_USER=""
DB_NAME=""
DB_PASS=''
DB_PREFIX="wp_"

# ===== Variáveis do tema =====
# Adicione aqui o que o tema precisar (SMTP, reCAPTCHA, etc.).
